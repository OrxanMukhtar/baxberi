# Copy this to /etc/turnserver.conf and replace every placeholder.
listening-port=3478
tls-listening-port=5349
listening-ip=PRIVATE_IPV4
relay-ip=PRIVATE_IPV4
external-ip=PUBLIC_IPV4/PRIVATE_IPV4
realm=YOUR_DOMAIN
server-name=YOUR_DOMAIN
fingerprint
use-auth-secret
static-auth-secret=USE_THE_SAME_VALUE_AS_TURN_SECRET
cert=/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem
pkey=/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem
min-port=49160
max-port=49200
no-cli
no-multicast-peers
no-loopback-peers
