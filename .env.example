PORT=3000
NODE_ENV=development
# Supabase Project URL + secret API key. Run supabase-schema.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
# Cloudflare R2 bucket, API token with Object Read & Write, and its enabled public custom domain.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_R2_BUCKET=baxberi-profile-images
CF_API_TOKEN=replace-with-cloudflare-api-token
R2_PUBLIC_URL=https://images.example.com
# coturn configured with use-auth-secret and the same shared secret; production requires these.
TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SECRET=replace-with-long-random-coturn-secret
